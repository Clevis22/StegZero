{
  "name": "stegzero",
  "version": "0.1.0",
  "description": "Hide secret messages in plain text with zero-width Unicode characters, and inspect or clean invisible characters",
  "keywords": [
    "steganography",
    "zero-width",
    "unicode",
    "invisible-characters",
    "watermark",
    "cli"
  ],
  "homepage": "https://stegzero.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Clevis22/StegZero.git"
  },
  "bugs": {
    "url": "https://github.com/Clevis22/StegZero/issues"
  },
  "license": "AGPL-3.0-only",
  "bin": {
    "stegzero": "bin/stegzero.js"
  },
  "files": [
    "bin/",
    "lib/",
    "stegzero-protocol.js",
    "unicode-inspector.js",
    "unicode-inspector-data.js",
    "CLI.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:cli": "node --test tests/cli-regression.test.mjs",
    "generate:unicode": "node scripts/generate-unicode-inspector-data.mjs",
    "sitemap": "node scripts/update-sitemap.mjs"
  },
  "devDependencies": {
    "jsdom": "^30.0.1"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  }
}
